@implements IAsyncDisposable
@inject IProfiledJSRuntime JS
<h2>Interop chatter</h2>
<p>Plots 120 points with one JavaScript call each, sends a large array in one call, and awaits a slow JavaScript promise.
   In the other direction, JavaScript reports 150 pointer moves to .NET with one call each (BP4007), or collects them and
   sends them in one call. Large data can be streamed instead: 200 KB to JavaScript, to .NET, and back.</p>
<button id="chatter" @onclick="ChatterAsync">Plot point by point</button>
<button id="batched" @onclick="BatchedAsync">Plot in one call</button>
<button id="slow-js" @onclick="SlowJsAsync">Slow JavaScript</button>
<button id="stream-to-dotnet" @onclick="StreamAsync">Send pointer moves to .NET one by one</button>
<button id="stream-batched" @onclick="StreamBatchedAsync">Send pointer moves in one call</button>
<button id="stream-data" @onclick="StreamDataAsync">Stream data</button>
<p id="interop-status">@status</p>
@code {
    private IJSObjectReference? module;
    private DotNetObjectReference<InteropChatter>? self;
    private int received;
    private string status = "";

    [JSInvokable]
    public void OnPointerMove(int x, int y) => received++;

    [JSInvokable]
    public void OnPointerMoves(int[][] moves) => received += moves.Length;

    [JSInvokable]
    public static string DemoPing() => "pong";

    [JSInvokable]
    public async Task<long> ReceiveStream(IJSStreamReference stream)
    {
        await using var data = await stream.OpenReadStreamAsync(maxAllowedSize: 1_000_000);
        var buffer = new byte[16 * 1024];
        long total = 0;
        int read;
        while ((read = await data.ReadAsync(buffer)) > 0)
        {
            total += read;
        }

        return total;
    }

    private async Task StreamDataAsync()
    {
        const int size = 200_000;
        self ??= DotNetObjectReference.Create(this);
        var m = await ModuleAsync();
        using var source = new MemoryStream(new byte[size]);
        var toJavaScript = await m.InvokeAsync<int>("receiveStream", new DotNetStreamReference(source, leaveOpen: true));
        var toDotNet = await m.InvokeAsync<long>("sendStream", self, size);
        await using var back = await m.InvokeAsync<IJSStreamReference>("makeStream", size);
        await m.InvokeAsync<int>("receiveBytes", new byte[50_000]);
        status = $"Streamed {toJavaScript} bytes to JavaScript, {toDotNet} bytes to .NET, {back.Length} bytes back";
    }

    private async Task StreamAsync()
    {
        received = 0;
        self ??= DotNetObjectReference.Create(this);
        var m = await ModuleAsync();
        var sent = await m.InvokeAsync<int>("streamToDotNet", self, 150, 8);
        var pong = await m.InvokeAsync<string>("pingStatic");
        status = $"Sent {sent} pointer moves to .NET with {sent} calls ({pong})";
    }

    private async Task StreamBatchedAsync()
    {
        received = 0;
        self ??= DotNetObjectReference.Create(this);
        var m = await ModuleAsync();
        await m.InvokeAsync<int>("streamBatchedToDotNet", self, 150, 8);
        status = $"Sent {received} pointer moves to .NET with one call";
    }

    private async Task<IJSObjectReference> ModuleAsync() =>
        module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./demo.js");

    private async Task ChatterAsync()
    {
        var m = await ModuleAsync();
        for (var i = 0; i < 120; i++)
        {
            await m.InvokeAsync<double>("plot", i, i * 2);
        }

        status = "Plotted 120 points with 120 calls";
    }

    private async Task BatchedAsync()
    {
        var m = await ModuleAsync();
        var points = Enumerable.Range(0, 20_000).Select(i => new Point(i, i * 2)).ToArray();
        // Wrapped explicitly: a Point[] would otherwise bind to the params object?[] argument list (array covariance) and
        // be sent as 20,000 separate arguments.
        var count = await m.InvokeAsync<int>("plotMany", new object?[] { points });
        status = $"Plotted {count} points with one call";
    }

    private async Task SlowJsAsync()
    {
        var m = await ModuleAsync();
        for (var i = 0; i < 3; i++)
        {
            await m.InvokeAsync<int>("wait", 160);
        }

        status = "Slow JavaScript done";
    }

    public async ValueTask DisposeAsync()
    {
        self?.Dispose();
        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    public sealed record Point(int x, int y);
}
